# ── Database: TiDB Cloud (MySQL protocol) ──────────────────────────
# TiDB Cloud → your cluster → Connect → "General" → copy the connection string.
# TLS is switched on automatically for *.tidbcloud.com hosts.
DATABASE_URL="mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/cas_erp"
# Force TLS on/off for other hosts (e.g. a self-hosted TiDB or local MySQL)
# DATABASE_SSL="true"
# DATABASE_POOL_SIZE="10"

# ── Authentication (Better Auth) ──────────────────────────────────
# Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=""
# The public URL the app is served from
BETTER_AUTH_URL="https://erp.cavemanarchitects.co.za"
# Extra allowed origins, comma separated (optional)
# BETTER_AUTH_TRUSTED_ORIGINS=""

# Two-factor is required for owner/admin/accountant. Only set to "false" for local testing.
# ENFORCE_2FA="true"
# Breached-password check (haveibeenpwned k-anonymity API). Set "true" only if the server has no internet.
# DISABLE_PWNED_CHECK="false"

# ── First-run seed ────────────────────────────────────────────────
SEED_OWNER_EMAIL="owner@cavemanarchitects.co.za"
SEED_OWNER_NAME="Studio Owner"
# Leave empty to generate a strong random password (printed once)
SEED_OWNER_PASSWORD=""
# "true" loads sample customers, invoices, bills and stock
SEED_DEMO="false"
